    {
      "name": "claw_combo",
      "cells": [
        { "x":  30, "y": 740, "w": 110, "h": 260 },
        { "x": 145, "y": 740, "w": 110, "h": 260 },
        { "x": 260, "y": 740, "w": 110, "h": 260 }
      ],
      "frameRate": 14
    },
    { "name": "shadow_dash",   "cells": [{ "x":  370, "y": 740, "w": 340, "h": 260 }], "frameRate": 18 },
